@model IEnumerable<StudentCourseRegistrationSystem.Models.Entities.Course>

@{
    ViewData["Title"] = "Courses";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Courses Management</h2>
    <div>
        <a asp-action="Create" class="btn btn-primary">➕ Create New Course</a>
        <a asp-action="PendingRequests" class="btn btn-warning ms-2">📋 Pending Requests</a>
    </div>
</div>

<table class="table table-bordered table-striped align-middle">
    <thead class="table-dark">
        <tr>
            <th>Code</th>
            <th>Title</th>
            <th>Department</th>
            <th>Credit Hours</th>
            <th>Max Students</th>
            <th>Status</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var course in Model)
        {
            <tr>
                <td><span class="badge bg-secondary">@course.CourseCode</span></td>
                <td class="fw-bold">@course.Title</td>
                <td>@course.Department</td>
                <td class="text-center">@course.CreditHours</td>
                <td class="text-center">@course.MaxStudents</td>
                <td>
                    @if (course.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">Inactive</span>
                    }
                </td>
                <td>
                    <a asp-action="Students" asp-route-id="@course.Id" class="btn btn-sm btn-info">View Students</a>
                    <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-warning ms-1">Edit</a>

                    <form asp-action="Delete" asp-route-id="@course.Id" method="post" class="d-inline ms-1">
                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>