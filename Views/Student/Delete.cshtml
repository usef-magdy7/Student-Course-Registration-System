@model StudentCourseRegistrationSystem.Models.Entities.Student
@{
    ViewData["Title"] = "Delete Student";
}

<h2>Delete Student</h2>
<h4 class="text-danger">Are you sure you want to delete this student?</h4>

<div class="card p-3 mb-3">
    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Date Of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</p>
    <p><strong>Level:</strong> @Model.Level</p>
    <p><strong>Department:</strong> @Model.Department</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
