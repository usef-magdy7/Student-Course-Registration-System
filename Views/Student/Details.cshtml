@model StudentCourseRegistrationSystem.Models.Entities.Student
@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>

<div class="card p-3 mb-3">
    <p><strong>Full Name:</strong> @Model.FullName</p>
    <p><strong>Email:</strong> @Model.Email</p>
    <p><strong>Phone:</strong> @Model.Phone</p>
    <p><strong>Date Of Birth:</strong> @Model.DateOfBirth.ToString("yyyy-MM-dd")</p>
    <p><strong>Level:</strong> @Model.Level</p>
    <p><strong>Department:</strong> @Model.Department</p>
</div>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to List</a>
