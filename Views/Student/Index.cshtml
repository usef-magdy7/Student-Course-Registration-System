@model IEnumerable<StudentCourseRegistrationSystem.Models.Entities.Student>
@{
    ViewData["Title"] = "Students List";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Students List</h2>
    <a asp-action="Create" class="btn btn-primary">Add New Student</a>
</div>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>FullName</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Date Of Birth</th>
            <th>Level</th>
            <th>Department</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            @foreach (var st in Model)
            {
                <tr>
                    <td>@st.Id</td>
                    <td>@st.FullName</td>
                    <td>@st.Email</td>
                    <td>@st.Phone</td>
                    <td>@st.DateOfBirth.ToString("yyyy-MM-dd")</td>
                    <td>@st.Level</td>
                    <td>@st.Department</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@st.Id" class="btn btn-info btn-sm">Details</a>
                        <a asp-action="Edit" asp-route-id="@st.Id" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@st.Id" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="8" class="text-center text-muted">No students found.</td>
            </tr>
        }
    </tbody>
</table>