@model StudentCourseRegistrationSystem.Models.ViewModels.CourseFormViewModel

@{
    ViewData["Title"] = "Create Course";
}

<h2>Create Course</h2>

<form asp-action="Create" method="post" class="mt-3 col-md-6">
    <div class="mb-3">
        <label asp-for="CourseCode" class="form-label"></label>
        <input asp-for="CourseCode" class="form-control" placeholder="e.g. CS101" />
        <span asp-validation-for="CourseCode" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Department" class="form-label"></label>
        <input asp-for="Department" class="form-control" placeholder="e.g. Computer Science" />
        <span asp-validation-for="Department" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="CreditHours" class="form-label"></label>
        <input asp-for="CreditHours" type="number" class="form-control" />
        <span asp-validation-for="CreditHours" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="MaxStudents" class="form-label"></label>
        <input asp-for="MaxStudents" type="number" class="form-control" />
    </div>

    <div class="form-check mb-3">
        <input asp-for="IsActive" class="form-check-input" />
        <label asp-for="IsActive" class="form-check-label"></label>
    </div>

    <button type="submit" class="btn btn-success">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>